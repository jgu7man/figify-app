{
  "manifest_version": 3,
  "name": "Figify Extractor",
  "version": "1.0.0",
  "description": "Extract semantic layouts directly from the live DOM and sync them to Figify.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
